{
  "id": "01-external-cursor-symlink",
  "title": "External .cursor symlink migration",
  "setup": {
    "symlinks": {
      ".cursor": "../IDE Development/.cursor"
    },
    "files": {
      "CONSUMER.md": {
        "kind": "text",
        "content": "consumer owned docs\n"
      }
    }
  },
  "expected": {
    "classifications": [
      {
        "path": ".cursor",
        "kind": "unsafe_link"
      }
    ],
    "preserve": [
      "CONSUMER.md"
    ],
    "fail_closed_if_unresolved_symlink": true,
    "notes": "Installer must replace external .cursor symlink with physical managed tree; never follow outside consumer."
  },
  "live_installer": {
    "proof": "external_cursor_symlink",
    "asserts": [
      "install fail-closes or replaces .cursor without following outside",
      "outside symlink target bytes/children untouched"
    ]
  }
}
