{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKlibraries/schemas/v2/dependency-lock.schema.json",
  "title": "LiNKlibraries deterministic dependency lock revision 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaRevision", "lockType", "manager", "lockVersion", "dependencies", "lockSha256"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "schemaRevision": { "const": 2 },
    "lockType": { "const": "deterministic_dependency_lock" },
    "manager": { "type": "string", "enum": ["npm", "pnpm", "yarn", "pip", "cargo", "go", "other"] },
    "lockVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "ecosystem", "source", "integritySha256", "dependencies"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "version": { "type": "string", "minLength": 1, "maxLength": 256 },
          "ecosystem": { "type": "string", "enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "other"] },
          "source": { "type": "string", "pattern": "^(?:https?://|file:|workspace:|registry:)[^\\s]+$" },
          "integritySha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "optional": { "type": "boolean" }
        }
      }
    },
    "lockSha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" }
  }
}
