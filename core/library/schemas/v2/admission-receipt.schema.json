{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKlibraries/schemas/v2/admission-receipt.schema.json",
  "title": "LiNKlibraries admission receipt revision 2",
  "allOf": [
    { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/receiptBase" },
    { "type": "object", "required": ["decision"], "properties": { "receiptType": { "const": "admission" } } },
    { "if": { "type": "object", "properties": { "decision": { "const": "admit" } } }, "then": { "type": "object", "required": ["principalApproval"] } }
  ]
}
