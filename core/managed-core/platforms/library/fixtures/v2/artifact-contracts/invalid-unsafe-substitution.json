{
  "artifactType": "starter_kit",
  "extension": {
    "cleanBootstrap": {
      "executable": "npm",
      "args": ["ci"]
    },
    "noExternalSymlinks": true,
    "environmentVariables": [],
    "substitutions": [
      {
        "target": "../outside/config.js",
