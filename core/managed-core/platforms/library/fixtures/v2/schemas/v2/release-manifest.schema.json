{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKlibraries/schemas/v2/release-manifest.schema.json",
  "title": "LiNKlibraries immutable release manifest revision 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaRevision", "manifestType", "releaseId", "entryId", "artifactType", "version", "releaseSource", "artifactTreeSha1", "payloadSha256", "inventorySha256", "dependencyLockSha256", "extension"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "schemaRevision": { "const": 2 },
    "manifestType": { "const": "immutable_release" },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 160 },
    "entryId": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/entryId" },
    "artifactType": { "type": "string", "enum": ["component", "starter_kit", "website_template"] },
    "version": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/semver" },
    "releaseSource": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/releaseSourceIdentity" },
    "artifactTreeSha1": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha1" },
    "payloadSha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
    "inventorySha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
    "dependencyLockSha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
    "extension": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/extension" },
    "controlledMetadata": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/controlledMetadata" },
    "externalReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalReference" }
    }
  },
  "$defs": {
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
      "maxLength": 127
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "byteLength", "sha256", "mediaType", "classification", "retention", "immutable", "runtimeDownload"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$", "minLength": 2, "maxLength": 128 },
        "uri": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/url" },
        "locator": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/url" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "classification": { "const": "public_reusable" },
        "retention": { "enum": ["release", "review_only"] },
        "immutable": { "const": true },
        "runtimeDownload": { "const": false }
      },
      "oneOf": [
        { "required": ["uri"], "not": { "required": ["locator"] } },
        { "required": ["locator"], "not": { "required": ["uri"] } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "artifactType": { "const": "component" } } },
      "then": { "properties": { "extension": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/componentExtension" } } }
    },
    {
      "if": { "type": "object", "properties": { "artifactType": { "const": "starter_kit" } } },
      "then": { "properties": { "extension": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/starterKitExtension" } } }
    },
    {
      "if": { "type": "object", "properties": { "artifactType": { "const": "website_template" } } },
      "then": { "properties": { "extension": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/websiteTemplateExtension" } } }
    }
  ]
}
