{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKlibraries/schemas/v2/contribution-intake.schema.json",
  "title": "LiNKlibraries contribution and candidate admissibility intake revision 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "entryId"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "schemaRevision": { "const": 2 },
    "type": { "enum": ["contribution", "usage_feedback", "candidate_admissibility"] },
    "contributionType": { "const": "candidate_admissibility" },
    "entryId": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/entryId" },
    "sourceCommitSha": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha1" },
    "inventorySha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRepository"],
      "properties": { "sourceRepository": { "type": "string", "minLength": 1, "maxLength": 512 } }
    },
    "generalizationRationale": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/nonEmptyString" },
    "removalAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretsRemoved", "customerDataRemoved"],
      "properties": { "secretsRemoved": { "const": true }, "customerDataRemoved": { "const": true } }
    },
    "candidate": { "$ref": "#/$defs/candidate" },
    "externalReferences": { "type": "array", "items": { "$ref": "#/$defs/externalReference" } },
    "version": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/semver" },
    "libraryCommitSha": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha1" },
    "artifactSha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "successScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "failureStage": { "type": "string", "minLength": 1 },
    "failedCommand": { "type": "string", "minLength": 1 },
    "errorClassification": { "type": "string", "minLength": 1 },
    "admission": { "const": false },
    "publish": { "const": false },
    "selfApproved": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "contribution" } } },
      "then": { "required": ["sourceCommitSha", "inventorySha256", "provenance", "generalizationRationale", "removalAssertions"] }
    },
    {
      "if": { "properties": { "type": { "const": "usage_feedback" } } },
      "then": { "required": ["version", "libraryCommitSha", "artifactSha256", "consumer", "successScore"] }
    },
    {
      "if": { "properties": { "type": { "const": "candidate_admissibility" } } },
      "then": { "required": ["sourceCommitSha", "candidate"] }
    }
  ],
  "$defs": {
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
      "maxLength": 127
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "retention", "content", "externalReferences"],
      "properties": {
        "classification": { "const": "public_reusable" },
        "retention": { "enum": ["release", "review_only"] },
        "admissibilityNotes": { "type": "array", "items": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/nonEmptyString" } },
        "content": { "type": "array", "items": { "$ref": "#/$defs/contentIdentity" } },
        "externalReferences": { "type": "array", "items": { "$ref": "#/$defs/externalReference" } }
      }
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "byteLength", "sha256", "mediaType", "classification", "retention", "immutable", "runtimeDownload"],
      "properties": {
        "kind": { "enum": ["text", "binary"] },
        "path": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "classification": { "const": "public_reusable" },
        "retention": { "enum": ["release", "review_only"] },
        "immutable": { "const": true },
        "runtimeDownload": { "const": false }
      }
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "byteLength", "sha256", "mediaType", "classification", "retention", "immutable", "runtimeDownload"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$", "minLength": 2, "maxLength": 128 },
        "uri": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/url" },
        "locator": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/url" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/sha256" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "classification": { "const": "public_reusable" },
        "retention": { "enum": ["release", "review_only"] },
        "immutable": { "const": true },
        "runtimeDownload": { "const": false }
      },
      "oneOf": [
        { "required": ["uri"], "not": { "required": ["locator"] } },
        { "required": ["locator"], "not": { "required": ["uri"] } }
      ]
    }
  }
}
