{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKlibraries/schemas/v2/lifecycle.schema.json",
  "title": "LiNKlibraries lifecycle and compatibility disposition revision 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaRevision", "entryId", "version", "lifecycle", "selectability", "compatibility", "reason"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "schemaRevision": { "const": 2 },
    "entryId": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/entryId" },
    "version": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/semver" },
    "lifecycle": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/lifecycleDisposition" },
    "selectability": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/selectabilityDisposition" },
    "compatibility": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/compatibilityDisposition" },
    "reason": { "$ref": "https://github.com/linktrend/LiNKlibraries/schemas/v2/common.schema.json#/$defs/nonEmptyString" }
  }
}
