{
  "schemaVersion": 1,
  "protocol": "portfolio-control-loop",
  "protocolVersion": "1.0",
  "cadenceSeconds": 3600,
  "supportedCadencesSeconds": [3600, 7200],
  "leaseSeconds": 180,
  "stalledAfterSeconds": 120,
  "replacementLimit": 1,
  "maxConcurrentWorkers": 8,
  "maxAutomationRetries": 1,
  "triggers": ["hourly", "PULSE"],
  "terminalStates": ["COMPLETED", "SUCCEEDED", "FAILED", "CANCELLED", "ARCHIVED"],
  "reportStatuses": ["DONE", "RUNNING", "HOLD"],
  "reportLanguages": ["ISSUED", "RUNNING", "FINISHED", "NOT ISSUED"]
}
