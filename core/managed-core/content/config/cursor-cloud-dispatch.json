{
  "schemaVersion": 3,
  "controlId": "cursor-cloud-dispatch-v3",
  "apiBaseUrl": "https://api.cursor.com",
  "apiPath": "/v1/agents",
  "apiKeyEnvironmentVariable": "CURSOR_002_API_KEY",
  "preferredClient": "cursor-sdk",
  "sdkPackage": "cursor-sdk",
  "directApiRepositoryBinding": "repos[]",
  "sdkRepositoryBinding": "CloudAgentOptions.repos",
  "routingRegistry": "content/config/routing-registry.json",
  "readbackRequired": true,
  "readbackFields": ["repository", "ref", "commit", "tree", "provider"],
  "modelResolution": "dispatch-time",
  "recordFields": ["requestedModel", "requestedParams", "selfReportedModel"],
  "archiveOnMismatchRequired": true,
  "maxApiAttempts": 2,
  "routes": {
    "cursor002-grok": {
      "provider": "cursor",
      "family": "grok-4.7",
      "params": {
        "context": "500k",
        "reasoning_effort": "medium",
        "fast": "false"
      }
    },
    "cursor002-opus": {
      "provider": "cursor",
      "family": "claude-opus-5-5",
      "params": {
        "context": "1m",
        "effort": "medium",
        "fast": "false"
      },
      "forbiddenAliases": ["opus", "opus-latest"]
    }
  },
  "cliLoginIsCloudAuthority": false
}
