{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/openclaw-customization-admission.schema.json",
  "title": "OpenClaw-only customization-scoped v2.5.2 admission",
  "description": "Fail-closed admission for LiNKtrend Prime customization paths plus v2.5.2 managed/transaction-changed paths. Does not authorize a whole-repository upstream OpenClaw scan or baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "installerVersion",
    "repository",
    "consumer",
    "upstream",
    "manifest",
    "checkedPaths",
    "findings",
    "verdict",
    "noUpstreamScanOrMutation"
  ],
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relPath": { "type": "string", "minLength": 1, "pattern": "^(?!/).+" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha40" },
        "tree": { "$ref": "#/$defs/sha40" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "rule"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relPath" },
        "line": { "type": "integer", "minimum": 1 },
        "field": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "openclaw-customization-admission" },
    "installerVersion": { "type": "string", "const": "2.5.2" },
    "repository": { "type": "string", "const": "linktrend/openclaw_prime" },
    "consumer": { "$ref": "#/$defs/identity" },
    "upstream": { "$ref": "#/$defs/identity" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contentDigest", "customizationPaths"],
      "properties": {
        "path": { "$ref": "#/$defs/relPath" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "customizationPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relPath" }
        }
      }
    },
    "checkedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relPath" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "verdict": { "type": "string", "enum": ["admitted", "rejected"] },
    "noUpstreamScanOrMutation": { "type": "boolean", "const": true }
  }
}
