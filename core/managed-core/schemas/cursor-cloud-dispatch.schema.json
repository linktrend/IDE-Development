{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/cursor-cloud-dispatch.schema.json",
  "title": "Cursor Cloud repository-bound dispatch control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "controlId", "apiBaseUrl", "apiPath",
    "apiKeyEnvironmentVariable", "preferredClient", "sdkPackage",
    "directApiRepositoryBinding", "sdkRepositoryBinding", "routingRegistry",
    "readbackRequired", "readbackFields", "modelResolution", "recordFields",
    "archiveOnMismatchRequired", "maxApiAttempts", "routes",
    "cliLoginIsCloudAuthority"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 3},
    "controlId": {"type": "string", "const": "cursor-cloud-dispatch-v3"},
    "apiBaseUrl": {"type": "string", "const": "https://api.cursor.com"},
    "apiPath": {"type": "string", "const": "/v1/agents"},
    "apiKeyEnvironmentVariable": {"type": "string", "const": "CURSOR_002_API_KEY"},
    "preferredClient": {"type": "string", "const": "cursor-sdk"},
    "sdkPackage": {"type": "string", "const": "cursor-sdk"},
    "directApiRepositoryBinding": {"type": "string", "const": "repos[]"},
    "sdkRepositoryBinding": {"type": "string", "const": "CloudAgentOptions.repos"},
    "routingRegistry": {"type": "string", "const": "content/config/routing-registry.json"},
    "readbackRequired": {"type": "boolean", "const": true},
    "readbackFields": {
      "type": "array",
      "const": ["repository", "ref", "commit", "tree", "provider"]
    },
    "modelResolution": {"type": "string", "const": "dispatch-time"},
    "recordFields": {
      "type": "array",
      "const": ["requestedModel", "requestedParams", "selfReportedModel"]
    },
    "archiveOnMismatchRequired": {"type": "boolean", "const": true},
    "maxApiAttempts": {"type": "integer", "const": 2},
    "routes": {"$ref": "#/$defs/routes"},
    "cliLoginIsCloudAuthority": {"type": "boolean", "const": false}
  },
  "$defs": {
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 2,
      "required": ["cursor002-grok", "cursor002-opus"],
      "properties": {
        "cursor002-grok": {"$ref": "#/$defs/grokRoute"},
        "cursor002-opus": {"$ref": "#/$defs/opusRoute"}
      }
    },
    "grokRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "family", "params"],
      "properties": {
        "provider": {"const": "cursor"},
        "family": {"const": "grok-4.7"},
        "params": {"$ref": "#/$defs/grokParams"}
      }
    },
    "opusRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "family", "params", "forbiddenAliases"],
      "properties": {
        "provider": {"const": "cursor"},
        "family": {"const": "claude-opus-5-5"},
        "params": {"$ref": "#/$defs/opusParams"},
        "forbiddenAliases": {"const": ["opus", "opus-latest"]}
      }
    },
    "grokParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "reasoning_effort", "fast"],
      "properties": {
        "context": {"const": "500k"},
        "reasoning_effort": {"const": "medium"},
        "fast": {"const": "false"}
      }
    },
    "opusParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "effort", "fast"],
      "properties": {
        "context": {"const": "1m"},
        "effort": {"const": "medium"},
        "fast": {"const": "false"}
      }
    }
  }
}
