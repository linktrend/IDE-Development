{
  "capability": {
    "rulesets": "ok",
    "branch_protection": "ok"
  },
  "actions_variables": [
    {
      "name": "LINKTREND_GITOPS_APP_ID",
      "value": "12345"
    }
  ],
  "actions_secret_names": [
    "LINKTREND_AUTOMATION_TOKEN",
    "LINKTREND_BUGBOT_USER_TOKEN"
  ],
  "installation": {
    "id": 99,
    "app_slug": "linktrend-gitops"
  },
  "app_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "checks": "write",
    "statuses": "write",
    "issues": "write",
    "metadata": "read",
    "actions": "read",
    "admin": "none",
    "members": "none",
    "secrets": "none"
  },
  "bugbot": {
    "manualTriggerOnly": true,
    "enabled": true
  },
  "carlos_user_token_boundary": {
    "allowedOps": [
      "orchestrator_pr_create",
      "bugbot_mention_comment"
    ],
    "status": "ok"
  },
  "rulesets": [
    {
      "id": 1,
      "name": "development-autonomous-merge",
      "enforcement": "active"
    },
    {
      "id": 3,
      "name": "main-autonomous-release",
      "enforcement": "active"
    }
  ],
  "ruleset_details": {
    "1": {
      "id": 1,
      "name": "development-autonomous-merge",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/development"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {
                "context": "Verify IDE Development"
              },
              {
                "context": "Linktrend Branch Source Policy"
              }
            ]
          }
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0
          }
        },
        {
          "type": "deletion"
        }
      ],
      "bypass_actors": []
    },
    "3": {
      "id": 3,
      "name": "main-autonomous-release",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/main"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {
                "context": "Verify IDE Development"
              },
              {
                "context": "Linktrend Branch Source Policy"
              },
              {
                "context": "Consumer Release Lint"
              }
            ]
          }
        }
      ],
      "bypass_actors": []
    }
  },
  "repo": {
    "allow_auto_merge": true
  },
  "workflows": [
    {
      "id": 1,
      "path": ".github/workflows/branch-source-policy.yml",
      "name": "branch-source-policy",
      "state": "active",
      "latestConclusion": "success",
      "permissions": {
        "contents": "read",
        "statuses": "write"
      }
    },
    {
      "id": 2,
      "path": ".github/workflows/ci.yml",
      "name": "ci",
      "state": "active",
      "latestConclusion": "success",
      "permissions": {
        "contents": "read",
        "statuses": "write"
      }
    },
    {
      "id": 5,
      "path": ".github/workflows/linktrend-integrator-merge.yml",
      "name": "linktrend-integrator-merge",
      "state": "active",
      "latestConclusion": "success",
      "permissions": {
        "contents": "read",
        "statuses": "write"
      }
    },
    {
      "id": 8,
      "path": ".github/workflows/linktrend-repair-observer.yml",
      "name": "linktrend-repair-observer",
      "state": "active",
      "latestConclusion": "success",
      "permissions": {
        "contents": "read",
        "statuses": "write"
      }
    },
    {
      "id": 9,
      "path": ".github/workflows/linktrend-cleanup-merged.yml",
      "name": "linktrend-cleanup-merged",
      "state": "active",
      "latestConclusion": "success",
      "permissions": {
        "contents": "read",
        "statuses": "write"
      }
    }
  ]
}
