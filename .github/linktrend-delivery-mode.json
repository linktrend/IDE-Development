{
  "schemaVersion": 2,
  "mode": "phase-integration",
  "compute": {
    "provider": "github-hosted",
    "runner": "ubuntu-24.04-arm",
    "checkpointCI": false,
    "cancelObsolete": true,
    "maxInfrastructureAttempts": 2,
    "maxSealedCandidates": 2
  },
  "profiles": {
    "fast": {
      "commands": [
        ["python3", "-m", "py_compile", "scripts/gitops/run_delivery_profile.py", "scripts/gitops/runtime_preflight.py", "scripts/gitops/secret_scan.py", "scripts/gitops/secret_scan_migrate.py", "scripts/gitops/mutation_guard.py", "scripts/gitops/generated_output_closure.py", "scripts/gitops/repository_ci_contract.py", "scripts/gitops/create_issue_branch.py", "scripts/gitops/github_auth.py", "scripts/gitops/repository_protection.py", "scripts/gitops/phase_integrator.py", "scripts/gitops/delivery_modes.py", "scripts/gitops/readiness_status.py", "scripts/dispatch/cursor002.py", "scripts/orchestrator/runlog.py", "scripts/orchestrator/watchdog.py", "scripts/codex/codex_orchestrator.py", "scripts/codex/set_codex_config.py"],
        ["python3", "scripts/gitops/secret_scan.py"],
        ["python3", "-m", "unittest", "scripts.tests.test_fixture_aware_secret_scan", "scripts.dispatch.test_cursor002", "scripts.tests.test_orchestrator_runlog_watchdog", "scripts.tests.test_codex_orchestrator", "scripts.tests.test_codex_config", "scripts.tests.test_repository_ci_trigger_contract", "scripts.tests.test_github_workflow_contract", "scripts.tests.test_delivery_profile_runner", "scripts.tests.test_runtime_preflight", "scripts.tests.test_mutation_guard", "scripts.tests.test_create_issue_branch"]
      ],
      "timeoutMinutes": 3
    },
    "full": {
      "required": true,
      "commands": [
        ["python3", "scripts/gitops/secret_scan.py"],
        ["python3", "-m", "unittest", "scripts.tests.test_phase_batch_lifecycle", "scripts.tests.test_fixture_aware_secret_scan", "scripts.tests.test_repository_ci_trigger_contract"],
        ["bash", "scripts/tests/test-gitops-phase-delivery.sh"]
      ]
    },
    "release": {
      "commands": [["python3", "scripts/ide-development.py", "version", "--json", "--dry-run"]]
    }
  },
  "promotion": {
    "reuseExactReceipt": true,
    "identity": [
      "repository",
      "headCommit",
      "gitTree",
      "dependencyDigest",
      "profileDigest",
      "workflowDigest"
    ]
  },
  "review": {
    "bugbot": "final-candidate-only"
  }
}
