{
  "schemaVersion": 2,
  "mode": "phase-integration",
  "compute": {
    "provider": "github-hosted",
    "runner": "ubuntu-24.04-arm",
    "checkpointCI": false,
    "cancelObsolete": true,
    "maxInfrastructureAttempts": 2,
    "maxSealedCandidates": 2
  },
  "profiles": {
    "fast": {
      "commands": [
        ["python3", "-m", "py_compile", "scripts/gitops/phase_integrator.py", "scripts/gitops/packager_coordinator.py", "scripts/gitops/secret_scan.py", "scripts/gitops/coordinator/state.py", "scripts/gitops/coordinator/receipts.py", "scripts/gitops/promotion_receipt_gate.py"],
        ["python3", "-m", "unittest", "scripts.tests.test_candidate_lifecycle", "scripts.tests.test_gate_receipts", "scripts.tests.test_promotion_receipt_gate", "scripts.tests.test_phase_packager_coordinator", "scripts.tests.test_fixture_aware_secret_scan"]
      ],
      "timeoutMinutes": 5
    },
    "full": {
      "required": true,
      "commands": [
        ["python3", "-m", "unittest", "scripts.tests.test_candidate_lifecycle", "scripts.tests.test_gate_receipts", "scripts.tests.test_promotion_receipt_gate", "scripts.tests.test_phase_batch_lifecycle", "scripts.tests.test_fixture_aware_secret_scan"],
        ["bash", "scripts/tests/test-gitops-phase-delivery.sh"]
      ]
    },
    "release": {
      "commands": [["python3", "scripts/ide-development.py", "version", "--json", "--dry-run"]]
    }
  },
  "promotion": {
    "reuseExactReceipt": true,
    "identity": [
      "repository",
      "gitTree",
      "dependencyDigest",
      "profileDigest",
      "workflowDigest"
    ]
  },
  "review": {
    "bugbot": "final-candidate-only"
  }
}
