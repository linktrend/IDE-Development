{
  "schemaVersion": 1,
  "kind": "repository-ci-contract",
  "aggregateContext": "Linktrend Full Suite",
  "profiles": {
    "fast": {
      "id": "fast",
      "commands": [
        [
          "python3",
          "-m",
          "py_compile",
          "scripts/gitops/repository_ci_contract.py",
          "scripts/gitops/run_delivery_profile.py",
          "scripts/gitops/gate_receipt.py"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "scripts.tests.test_repository_ci_trigger_contract"
        ]
      ],
      "requiredCheckContexts": ["Linktrend Fast Checks"],
      "timeoutMinutes": 5
    },
    "full": {
      "id": "full",
      "commands": [],
      "requiredCheckContexts": ["Linktrend Full Suite"]
    },
    "scheduled": {
      "id": "scheduled",
      "commands": []
    },
    "promotion": {
      "id": "promotion",
      "commands": [],
      "requiredCheckContexts": [
        "Linktrend Branch Source Policy",
        "Linktrend Receipt Gate"
      ]
    },
    "trusted-governance": {
      "id": "trusted-governance",
      "commands": [
        [
          "python3",
          "-m",
          "unittest",
          "scripts.tests.test_repository_ci_trigger_contract"
        ]
      ],
      "requiredCheckContexts": ["Verify IDE Development"]
    }
  },
  "coverageComponents": [
    {
      "id": "governance-gate-contract",
      "mandatory": true,
      "category": "governance"
    },
    {
      "id": "secret-scan",
      "mandatory": true,
      "category": "security",
      "commands": [["python3", "scripts/gitops/secret_scan.py"]]
    },
    {
      "id": "application-tests",
      "mandatory": true,
      "category": "test"
    },
    {
      "id": "production-resolution",
      "mandatory": true,
      "category": "production-resolution"
    }
  ],
  "trustedGovernance": {
    "pathPrefixes": [
      ".github/workflows/",
      ".github/linktrend-",
      "core/github/",
      "core/managed-core/schemas/",
      "core/managed-core/content/doctrine/",
      "scripts/gitops/",
      "docs/contracts/",
      "docs/adr/"
    ],
    "requiredProofs": [
      "gate-contract",
      "workflow-syntax",
      "identity-receipt",
      "ruleset-migration",
      "rollback",
      "no-application-path"
    ]
  },
  "expensiveWorkflowMarkers": [
    "full",
    "matrix",
    "e2e",
    "integration",
    "browser",
    "playwright",
    "cypress",
    "docker",
    "build-and-test",
    "verify ide development"
  ],
  "promotionPolicy": {
    "schemaVersion": 1,
    "id": "lean-promotion-v1",
    "promotionRefPrefix": "promote/",
    "phaseRefPrefix": "phase/",
    "developmentBranches": ["development"],
    "retainedCheckContexts": {
      "phase": ["Linktrend Fast Checks", "Linktrend Full Suite"],
      "promotion": [
        "Linktrend Branch Source Policy",
        "Linktrend Receipt Gate"
      ]
    },
    "reuseAcceptedChecks": true,
    "duplicateBroadSuite": false,
    "authorizedWorkflowPaths": [
      ".github/workflows/ci-build-artifacts-testbox.yml",
      ".github/workflows/ci-check-arm-testbox.yml",
      ".github/workflows/ci-check-testbox.yml",
      ".github/workflows/ci.yml",
      ".github/workflows/codeql-critical-quality.yml",
      ".github/workflows/codeql.yml",
      ".github/workflows/control-ui-locale-refresh.yml",
      ".github/workflows/docker-release.yml",
      ".github/workflows/live-media-runner-image.yml",
      ".github/workflows/native-app-locale-refresh.yml",
      ".github/workflows/npm-telegram-beta-e2e.yml",
      ".github/workflows/openclaw-live-and-e2e-checks-reusable.yml",
      ".github/workflows/openclaw-stable-main-closeout.yml",
      ".github/workflows/opengrep-precise.yml",
      ".github/workflows/plugin-npm-release.yml",
      ".github/workflows/sandbox-common-smoke.yml",
      ".github/workflows/website-installer-sync.yml"
    ],
    "migration": {
      "id": "lean-promotion-workflow-migration-v1",
      "schemaVersion": 1,
      "mode": "consumer-executable-plan",
      "requiresExplicitRolloutScope": true,
      "reportOnlyIsMutationAuthority": false,
      "preserveApplicationCommands": true
    }
  }
}
